---
// The quarter slider under the map: a native range input over the dataset's quarters, the current
// quarter beside it, and a play button that steps to the latest quarter and stops there.
import { findings } from '../../data/findings';

const { quarters } = findings.choices;
const first = quarters[0];
const last = quarters[quarters.length - 1];
---

<div class="slider" data-quarter-slider>
  <button type="button" class="play" data-play disabled>
    <span class="icon" aria-hidden="true" data-play-icon>&#9654;</span>
    <span data-play-label>Play</span>
  </button>

  <div class="track">
    <label class="visually-hidden" for="explorer-quarter">Quarter</label>
    <input
      type="range"
      id="explorer-quarter"
      min="0"
      max={quarters.length - 1}
      step="1"
      value={quarters.length - 1}
      aria-valuetext={last}
      data-quarter-input
      disabled
    />
    <div class="ends" aria-hidden="true">
      <span>{first}</span>
      <span>{last}</span>
    </div>
  </div>

  <output class="now" for="explorer-quarter" data-quarter-now>{last}</output>
</div>

<style>
  .slider {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: start;
  }

  .play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    /* Wide enough for "Pause", so the slider does not shift when the label changes. */
    min-width: 5.4rem;
    min-height: 2rem;
    padding: 0.3rem 0.7rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 0;
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }
  .play:disabled {
    cursor: default;
    opacity: 0.6;
  }
  .icon {
    font-size: 0.7em;
  }

  input {
    display: block;
    width: 100%;
    height: 2rem;
    margin: 0;
    accent-color: var(--chart-series-1);
    cursor: pointer;
  }
  input:focus-visible {
    /* Tight to the track, so the ring does not run over the labels under it. */
    outline-offset: 0;
  }
  .ends {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    margin-top: 0.2rem;
    color: var(--chart-text-muted);
    line-height: 1.2;
  }

  .now {
    min-width: 7ch;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 2rem;
    color: var(--chart-text-strong);
    text-align: right;
  }

  /* Touch widths, and any touch screen: 44px targets. */
  @media (max-width: 979px), (pointer: coarse) {
    .play {
      min-height: 2.75rem;
    }
    input {
      height: 2.75rem;
    }
    .now {
      line-height: 2.75rem;
    }
  }
</style>

<script>
  import { mountSlider } from './slider';

  const root = document.querySelector<HTMLElement>('[data-quarter-slider]');
  if (root) void mountSlider(root);
</script>
