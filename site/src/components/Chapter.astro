---
// One Headline finding as a full-width chapter: text on the left, a large chart on the right.
//
// Slots
//   (default)   the finding's text, as one or more <p>
//   definition  optional aside defining the terms the finding uses
//   chart       the chart itself; until it is supplied an empty frame holds its place
//   source      optional extra sentence after "Synthetic data. Simulated figures calibrated to published research."
import EmptyFrame from './EmptyFrame.astro';
import SourceLine from './SourceLine.astro';

interface Props {
  /** 1 to 4. Also gives the section its id, "finding-1", which the summary strip links to. */
  number: number;
  /** The finding in a few words. */
  title: string;
  /** The chart's headline: what the chart shows. */
  chartTitle: string;
  /** What is measured and over what, under the chart title. */
  chartSubtitle: string;
  /** Width over height of the chart area, as CSS. Sizes the empty frame. */
  chartRatio?: string;
  /** Label on the empty frame while there is no chart. */
  chartPlaceholder?: string;
  /** Selection for the "See this in the Explorer" link, as a query string: "?sector=finance-banking". */
  explorerQuery?: string;
}

const {
  number,
  title,
  chartTitle,
  chartSubtitle,
  chartRatio = '500 / 285',
  chartPlaceholder = 'Chart goes here',
  explorerQuery = '',
} = Astro.props;

const id = `finding-${number}`;
// BASE_URL may or may not end in a slash depending on the configured base.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="chapter" id={id} aria-labelledby={`${id}-title`}>
  <div class="text">
    <h2 id={`${id}-title`}>
      <span class="number">{number}<span class="visually-hidden">.</span></span>
      {title}
    </h2>
    <div class="prose"><slot /></div>
    {
      Astro.slots.has('definition') && (
        <div class="definition" role="note" aria-label="Definitions">
          <slot name="definition" />
        </div>
      )
    }
    <a class="explorer-link" href={`${base}${explorerQuery}#explorer`}>
      See this in the Explorer <span aria-hidden="true">↓</span>
    </a>
  </div>

  <figure class="chart" aria-labelledby={`${id}-chart-title`}>
    <p class="chart-title" id={`${id}-chart-title`}>{chartTitle}</p>
    <p class="chart-subtitle">{chartSubtitle}</p>
    <div class="chart-area" data-chart-slot={id}>
      <slot name="chart">
        <EmptyFrame label={chartPlaceholder} ratio={chartRatio} />
      </slot>
    </div>
    <figcaption><SourceLine><slot name="source" /></SourceLine></figcaption>
  </figure>
</section>

<style>
  .chapter {
    display: grid;
    gap: var(--space-5) var(--space-8);
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-ink);
    scroll-margin-top: 0;
  }
  /* Grid children must be allowed to shrink below the width of a chart. */
  .text,
  .chart {
    min-width: 0;
  }

  h2 {
    font-size: var(--text-chapter);
  }
  .number {
    display: block;
    margin-bottom: 0.9rem;
    font-size: var(--text-chapter-number);
    font-style: italic;
    font-weight: 400;
    line-height: 0.8;
    color: var(--color-accent);
  }

  .prose {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--text-prose);
    line-height: 1.5;
    color: var(--color-body);
  }
  .prose :global(p) {
    max-width: 34ch;
  }
  .prose :global(p + p) {
    margin-top: 0.9rem;
  }

  .definition {
    max-width: 38ch;
    margin-top: 1.3rem;
    padding-left: 0.8rem;
    border-left: 2px solid var(--color-rule);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-faint);
  }
  .definition :global(b),
  .definition :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .explorer-link {
    display: inline-block;
    margin-top: 1.1rem;
    padding-block: 0.2rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
  }
  .explorer-link:hover {
    text-decoration-thickness: 2px;
  }

  .chart-title {
    font-size: var(--text-chart-title);
    font-weight: 600;
    line-height: 1.3;
  }
  .chart-subtitle {
    margin-bottom: 0.9rem;
    font-size: var(--text-sm);
    color: var(--color-faint);
  }
  /* Whatever fills the chart slot is stretched to the column; an inline SVG keeps its viewBox ratio. */
  .chart-area :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 900px) {
    .chapter {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
    .text {
      position: sticky;
      top: var(--space-6);
    }
  }
</style>
